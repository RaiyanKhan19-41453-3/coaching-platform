{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=db;Database=coaching;Username=coaching;Password=coaching"
  },
  "Jwt": {
    "Key": "dev-only-signing-key-change-this-in-production-1234",
    "Issuer": "coaching-platform",
    "Audience": "coaching-web",
    "AccessTokenMinutes": 30
  },
  "RateLimit": {
    "PerTenantPerMinute": 6000,
    "AuthPerIpPerMinute": 100
  },
  "Cors": {
    "Origins": ["http://localhost:3000", "http://web"]
  }
}
