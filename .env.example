# Copy to .env before running docker compose
POSTGRES_DB=coaching
POSTGRES_USER=coaching
POSTGRES_PASSWORD=change_me_please
POSTGRES_PORT=15432

REDIS_PORT=16379

MINIO_ROOT_USER=coaching
MINIO_ROOT_PASSWORD=change_me_please
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

PGADMIN_EMAIL=admin@coaching.local
PGADMIN_PASSWORD=change_me_please
PGADMIN_PORT=5050

API_PORT=18081
WEB_PORT=13000

JWT_KEY=change-this-to-a-long-random-secret-in-production

# ---- Optional: email / SMS delivery ----
# Leave SMTP_HOST and SMS_WEBHOOK empty to disable delivery (notifications stay in-app).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com
SMS_WEBHOOK=

# ---- Optional: observability ----
SEQ_URL=
OTEL_ENDPOINT=

# ---- Rate limits ----
RATE_TENANT_LIMIT=6000
RATE_AUTH_LIMIT=100
