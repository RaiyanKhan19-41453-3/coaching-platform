# =============================================================================
# Coaching Platform — environment template
#
#   cp .env.example .env      # then edit .env; NEVER commit it (gitignored)
#
# Every value below is read by docker-compose.yml. Empty optional values simply
# disable that feature; the rest of the stack keeps working.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core services (used by the normal `docker compose up`)
# -----------------------------------------------------------------------------
POSTGRES_DB=coaching
POSTGRES_USER=coaching
POSTGRES_PASSWORD=REPLACE_WITH_A_DEV_PASSWORD          # local dev only; must change for prod
POSTGRES_PORT=15432                                     # host port for psql

REDIS_PORT=16379                                        # host port; Redis used by SignalR backplane

MINIO_ROOT_USER=coaching
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_DEV_PASSWORD          # local dev only; must change for prod
MINIO_PORT=9000                                          # S3 API (presigned upload/download URLs)
MINIO_CONSOLE_PORT=9001                                  # web console

API_PORT=18081                                           # API + OpenAPI + Scalar + SignalR
WEB_PORT=13000                                           # React app

# Generate a real one with: openssl rand -hex 32
JWT_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET    # >= 32 chars, not the dev default


# -----------------------------------------------------------------------------
# 2. Optional admin tool (only with: docker compose --profile tools up -d)
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@coaching.local
PGADMIN_PASSWORD=REPLACE_WITH_PGADMIN_PASSWORD
PGADMIN_PORT=5050


# -----------------------------------------------------------------------------
# 3. Email delivery  (optional)
# Leave SMTP_HOST empty to disable. In-app notifications + SignalR still work.
# -----------------------------------------------------------------------------
SMTP_HOST=                       # e.g. smtp.gmail.com
SMTP_PORT=587                    # 587 = STARTTLS
SMTP_USER=                       # e.g. you@gmail.com
SMTP_PASSWORD=                   # use an app password, not your login password
SMTP_FROM=noreply@your-domain.com


# -----------------------------------------------------------------------------
# 4. SMS delivery  (optional)
# Leave empty to disable. The worker POSTs JSON to this URL:
#   { "to": "+8801XXXXXXXXX", "message": "..." }
# Point it at your provider or a small forwarding adapter.
# -----------------------------------------------------------------------------
SMS_WEBHOOK=


# -----------------------------------------------------------------------------
# 5. Observability  (optional)
# -----------------------------------------------------------------------------
SEQ_URL=                         # e.g. http://seq:5341
OTEL_ENDPOINT=                   # e.g. http://otel-collector:4318


# -----------------------------------------------------------------------------
# 6. Rate limits  (optional; defaults shown)
# -----------------------------------------------------------------------------
RATE_TENANT_LIMIT=6000           # requests / minute / tenant (globally, via Redis)
RATE_AUTH_LIMIT=100
# Shared secret used by the exam service to push result notifications here
EXAM_INTEGRATION_KEY=dev-integration-key              # login/register/refresh attempts / minute / IP


# -----------------------------------------------------------------------------
# 7. Production overlay only
# Used ONLY with:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# These are required by that file — it refuses to start without them.
# -----------------------------------------------------------------------------
JWT_ISSUER=coaching-platform
JWT_AUDIENCE=coaching-web
MINIO_PUBLIC_ENDPOINT=http://localhost:9000             # browser-reachable MinIO host (for presigned URLs)
WEB_ORIGIN=http://localhost:3000                        # CORS origin of the deployed React app
